#!/usr/bin/env sh

# Utilities
alias l='LC_COLLATE=C ls -lAFh --group-directories-first'
alias tree="tree -aCF --dirsfirst -I .git"
alias d="du -hd1"
alias ..="cd .."
alias halt='shutdown -h now'

# Base64
alias b64='base64 <<< '
alias d64='base64 -D <<< '

# md5
alias md5='md5sum'

# Git
alias gs="git status"
alias gc="git commit -m"
alias gp="git push"
alias gb="git branch -a"
alias gd="git diff"
alias gds="git diff --staged"
