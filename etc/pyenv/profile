export PYENV_ROOT="$HOME/.config/pyenv"

if ! command -v pyenv > /dev/null
then
    # when installed with brew, binary is already in PATH
    [ "$(uname)" = Darwin ] || PATH="$PATH:$PYENV_ROOT/bin"
    PATH="$PYENV_ROOT/shims:$PATH"
fi

pyenv() {
  local command
  command="${1:-}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$command" in
  rehash|shell)
    eval "$(pyenv "sh-$command" "$@")"
    ;;
  *)
    command pyenv "$command" "$@"
    ;;
  esac
}
