export JENV_ROOT="$HOME/.config/jenv"

unset JAVA_HOME
unset JDK_HOME

if ! command -v jenv > /dev/null
then
    # when installed with brew, binary is already in PATH
    [ "$(uname)" = Darwin ] || PATH="$PATH:$JENV_ROOT/bin"
    PATH="$JENV_ROOT/shims:$PATH"
fi

jenv() {
  type typeset &> /dev/null && typeset command
  command="$1"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$command" in
  enable-plugin|rehash|shell|shell-options)
    eval "\`jenv \"sh-\$command\" \"\$@\"\`"
    ;;
  *)
    command jenv "$command" "$@"
    ;;
  esac
}
