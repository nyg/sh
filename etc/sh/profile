add_to_path()
{
    prepend=0
    if [ $1 = "-p" ]
    then
        prepend=1
        shift
    fi

    [ ! -d "$1" ] && return
    echo $PATH | grep "$1" > /dev/null && return

    if [ $prepend -eq 1 ]
    then
        PATH="$1:$PATH"
    else
        PATH="$PATH:$1"
    fi
}

# XDG base directory specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
mkdir -p $XDG_CONFIG_HOME $XDG_CACHE_HOME $XDG_DATA_HOME $XDG_STATE_HOME

if [ "$(uname)" = "Linux" ]
then
    export XDG_DATA_DIRS="/usr/local/share:/usr/share"
    export XDG_CONFIG_DIRS="/etc/xdg"
fi

# common env var
VISUAL=vim
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export ANDROID_HOME="$XDG_DATA_HOME/android"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NODE_REPL_HISTORY="$XDG_STATE_HOME/node/history"
mkdir -p $(dirname $LESSHISTFILE) \
         $ANDROID_HOME \
         $DOCKER_CONFIG \
         $(dirname $NPM_CONFIG_USERCONFIG) \
         $(dirname $NODE_REPL_HISTORY)

# source any file in etc/sh/profile.d/
for file in "$HOME"/".$USER-sh"/etc/sh/profile.d/*
do
    . "$file"
done

# source .bashrc if bash login shell
if [ -n "$BASH_VERSION" ] && shopt -q login_shell && [ -f "$HOME/.bashrc" ]
then
    . "$HOME/.bashrc"
fi
