[advice]
    detachedHead = false

[alias]
    co = checkout
    b = branch
    r = remote
    s = status
    w = worktree

[core]
    precomposeUnicode = false
    editor = vim
    excludesFile = ~/.config/git/global-ignore

[diff]
    guiTool = opendiff

[diffTool]
    prompt = false

[init]
    defaultBranch = master

[pager]
    branch = false

[pull]
    rebase = false
